{
  "name": "@zoobzio/foundation",
  "version": "1.0.6",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "layers/foundation"
  },
  "files": [
    "app",
    "nuxt.config.ts"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./components/*": "./app/components/*.vue",
    "./components/*.vue": "./app/components/*.vue",
    "./composables/*": "./app/composables/*.ts",
    "./constants/*": "./app/constants/*.ts",
    "./definitions/*": "./app/definitions/*.ts",
    "./factories/*": "./app/factories/*.ts",
    "./plugins/*": "./app/plugins/*.ts",
    "./services/*": "./app/services/*.ts",
    "./stores/*": "./app/stores/*.ts",
    "./types/*": "./app/types/*.ts",
    "./utils/*": "./app/utils/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "prepare": "nuxi prepare",
    "typecheck": "nuxi typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@internationalized/date": "^3.7.0",
    "@nuxt/kit": "^4.5.0",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "@zoobzio/chart": "workspace:*",
    "@zoobzio/deck": "workspace:*",
    "chart.js": "^4.5.1",
    "defu": "^6.1.7",
    "ltrl-http": "^0.0.20",
    "objectively": "^0.3.0",
    "reka-ui": "^2.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.8",
    "happy-dom": "^20.9.0",
    "nuxt": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.24",
    "vue-tsc": "^2.1.10"
  }
}
