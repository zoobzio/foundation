{
  "name": "@zoobzio/calendar",
  "version": "0.1.12",
  "description": "Headless calendar service over JSCalendar 2.0: the entries a backend serves, the occurrences they recur into, the view and the range a view reads, and reader/writer seams for the form a consumer ingests and consumes. No framework dependency.",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "services/calendar"
  },
  "files": [
    ".dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zoobzio/kit": "workspace:*",
    "@zoobzio/query": "workspace:*",
    "rrule-temporal": "catalog:",
    "temporal-polyfill": "catalog:"
  }
}
