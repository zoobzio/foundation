{
  "name": "@zoobzio/timeline",
  "version": "0.1.13",
  "description": "Headless timeline service: records in the order of their time, a batch at a time by cursor, grouped under the day, month, or year each falls in, with a search over the fields the config declares. No framework dependency.",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "services/timeline"
  },
  "files": [
    ".dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zoobzio/kit": "workspace:*",
    "@zoobzio/query": "workspace:*",
    "@zoobzio/sync": "workspace:*"
  }
}
