{
  "name": "@zoobzio/sync",
  "version": "0.1.11",
  "description": "Headless sync service: a polling interval a visitor sets, the time of the last sync, and the loop that polls for what changed since. No framework dependency.",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "services/sync"
  },
  "files": [
    ".dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zoobzio/kit": "workspace:*"
  }
}
