{
  "name": "@zoobzio/foundation-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zoobzio/foundation dev",
    "dev:example": "pnpm --filter @zoobz-io/foundation-example dev",
    "build": "pnpm -r build",
    "prepare": "pnpm -r prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @zoobzio/foundation test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:release": "pnpm -r publish --no-git-checks && changeset tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0"
  },
  "packageManager": "pnpm@10.27.0"
}
