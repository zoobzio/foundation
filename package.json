{
  "name": "@zoobzio/foundation",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./components/*": "./app/components/*.vue",
    "./components/*.vue": "./app/components/*.vue",
    "./composables/*": "./app/composables/*.ts",
    "./constants/*": "./app/constants/*.ts",
    "./definitions/*": "./app/definitions/*.ts",
    "./factories/*": "./app/factories/*.ts",
    "./plugins/*": "./app/plugins/*.ts",
    "./services/*": "./app/services/*.ts",
    "./stores/*": "./app/stores/*.ts",
    "./types/*": "./app/types/*.ts",
    "./utils/*": "./app/utils/*.ts",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "version": "0.0.16",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git"
  },
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "files": [
    "app",
    "config",
    "modules",
    "stubs",
    "nuxt.config.ts"
  ],
  "scripts": {
    "dev": "nuxi dev",
    "dev:example": "nuxi dev example",
    "build": "nuxi build",
    "prepare": "nuxi prepare",
    "prepare:example": "nuxi prepare example",
    "typecheck:example": "nuxi typecheck example",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:release": "pnpm -r publish --no-git-checks && changeset tag"
  },
  "packageManager": "pnpm@10.27.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "@internationalized/date": "^3.7.0",
    "@nuxt/kit": "^4.5.0",
    "@types/aria-query": "^5.0.4",
    "@untheme/aurora": "^0.2.1",
    "@untheme/nuxt": "^0.2.1",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "aria-query": "^5.3.2",
    "chart.js": "^4.5.1",
    "defu": "^6.1.7",
    "ltrl-http": "^0.0.20",
    "objectively": "^0.1.0",
    "reka-ui": "^2.6.0",
    "untheme": "^0.2.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@nuxt/eslint-config": "^1.4.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.8",
    "eslint": "^9.0.0",
    "happy-dom": "^20.9.0",
    "nuxt": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "vue": "^3.5.24",
    "vue-tsc": "^2.1.10"
  }
}
