{
  "name": "@zoobzio/foundation",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter @zoobzio/nuxt dev",
    "build": "turbo run build",
    "stub": "turbo run stub",
    "lint": "oxlint",
    "format": "oxfmt",
    "inspect": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "coverage": "vitest run --coverage",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "obuild": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
