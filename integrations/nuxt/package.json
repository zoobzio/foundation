{
  "name": "@zoobzio/nuxt",
  "version": "0.0.5",
  "description": "Nuxt layer for the foundation design system: the Nuxt wiring over @zoobzio/vue and the headless services (useState stores, hook-bus factories, app shell).",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "integrations/nuxt"
  },
  "files": [
    "app",
    "modules",
    "nuxt.config.ts"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./components/*": "./app/components/*.vue",
    "./components/*.vue": "./app/components/*.vue",
    "./composables/*": "./app/composables/*.ts",
    "./constants/*": "./app/constants/*.ts",
    "./definitions/*": "./app/definitions/*.ts",
    "./factories/*": "./app/factories/*.ts",
    "./plugins/*": "./app/plugins/*.ts",
    "./services/*": "./app/services/*.ts",
    "./stores/*": "./app/stores/*.ts",
    "./types/*": "./app/types/*.ts",
    "./utils/*": "./app/utils/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "prepare": "nuxi prepare",
    "lint": "oxlint",
    "typecheck": "nuxi typecheck",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@zoobzio/browser": "workspace:*",
    "@zoobzio/code": "workspace:*",
    "@zoobzio/editor": "workspace:*",
    "@zoobzio/form": "workspace:*",
    "@zoobzio/table": "workspace:*",
    "@zoobzio/vue": "workspace:*",
    "ltrl-http": "catalog:",
    "objectively": "catalog:",
    "reka-ui": "catalog:"
  },
  "devDependencies": {
    "@codemirror/state": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "zod": "catalog:"
  }
}
