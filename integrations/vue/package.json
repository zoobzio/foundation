{
  "name": "@zoobzio/vue",
  "version": "0.0.1",
  "description": "Vue 3 components for the foundation design system: unstyled interactive components composing reka-ui primitives and semantic HTML, exposed through passthrough and ctx-scoped slots. No Nuxt dependency.",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "integrations/vue"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components/*": "./src/components/*.vue",
    "./components/*.vue": "./src/components/*.vue",
    "./composables/*": "./src/composables/*.ts",
    "./constants/*": "./src/constants/*.ts",
    "./definitions/*": "./src/definitions/*.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@zoobzio/browser": "workspace:*",
    "@zoobzio/form": "workspace:*",
    "@zoobzio/kit": "workspace:*",
    "@zoobzio/query": "workspace:*",
    "@zoobzio/table": "workspace:*",
    "defu": "catalog:",
    "objectively": "catalog:",
    "reka-ui": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:peers"
  }
}
