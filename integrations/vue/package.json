{
  "name": "@zoobzio/vue",
  "version": "0.0.14",
  "description": "Vue 3 components for the foundation design system: unstyled interactive components composing reka-ui primitives and semantic HTML, exposed through passthrough and ctx-scoped slots. No Nuxt dependency.",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "integrations/vue"
  },
  "files": [
    "src",
    ".dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./components/*": {
      "types": "./.dist/components/*.vue.d.ts",
      "default": "./src/components/*.vue"
    },
    "./components/*.vue": {
      "types": "./.dist/components/*.vue.d.ts",
      "default": "./src/components/*.vue"
    },
    "./composables/*": {
      "types": "./.dist/composables/*.d.ts",
      "default": "./src/composables/*.ts"
    },
    "./constants/*": {
      "types": "./.dist/constants/*.d.ts",
      "default": "./src/constants/*.ts"
    },
    "./definitions/*": {
      "types": "./.dist/definitions/*.d.ts",
      "default": "./src/definitions/*.ts"
    },
    "./types/*": {
      "types": "./.dist/types/*.d.ts",
      "default": "./src/types/*.ts"
    },
    "./utils/*": {
      "types": "./.dist/utils/*.d.ts",
      "default": "./src/utils/*.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "components/*.vue": [
        ".dist/components/*.vue.d.ts"
      ],
      "components/*": [
        ".dist/components/*.vue.d.ts"
      ],
      "composables/*": [
        ".dist/composables/*.d.ts"
      ],
      "constants/*": [
        ".dist/constants/*.d.ts"
      ],
      "definitions/*": [
        ".dist/definitions/*.d.ts"
      ],
      "types/*": [
        ".dist/types/*.d.ts"
      ],
      "utils/*": [
        ".dist/utils/*.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "vue-tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@zoobzio/browser": "workspace:*",
    "@zoobzio/code": "workspace:*",
    "@zoobzio/editor": "workspace:*",
    "@zoobzio/form": "workspace:*",
    "@zoobzio/kit": "workspace:*",
    "@zoobzio/query": "workspace:*",
    "@zoobzio/table": "workspace:*",
    "defu": "catalog:",
    "objectively": "catalog:",
    "reka-ui": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:peers"
  }
}
