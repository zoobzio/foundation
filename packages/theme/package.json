{
  "name": "@zoobzio/theme",
  "version": "0.0.14",
  "description": "The foundation design system's theme: the aurora preset of untheme with the foundation palette as its base and the roles the Nuxt layer's shell reads, built by @untheme/kit into the modules, the layers, and the preset manifest a downstream theme or app extends.",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "packages/theme"
  },
  "files": [
    ".output",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./.output/index.mjs",
  "types": "./.output/index.d.mts",
  "exports": {
    ".": {
      "types": "./.output/index.d.mts",
      "import": "./.output/index.mjs"
    },
    "./config": {
      "types": "./.output/config.d.mts",
      "import": "./.output/config.mjs"
    },
    "./manifest": {
      "types": "./.output/manifest.d.mts",
      "import": "./.output/manifest.mjs"
    },
    "./layers": {
      "types": "./.output/layers.d.mts",
      "import": "./.output/layers.mjs"
    },
    "./layers/*": "./.output/layers/*",
    "./preset.json": "./.output/preset.json",
    "./resolver.json": "./.output/resolver.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "untheme build",
    "stub": "untheme build",
    "prepare": "untheme build",
    "generate": "node scripts/generate.mjs",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@untheme/aurora": "catalog:",
    "untheme": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@untheme/kit": "catalog:",
    "@untheme/testing": "catalog:",
    "vitest": "catalog:"
  }
}
