{
  "name": "@zoobzio/prose",
  "version": "0.1.5",
  "description": "The foundation design system's text: every label, placeholder and notice its components render, authored as FormatJS messages and built by @prosary/kit into a typed contract and a bundle per locale. An app's own prosary config extends it, so the components' text translates with the app's.",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "packages/prose"
  },
  "files": [
    ".dist",
    ".i18n",
    "prosary.config.ts",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./bundles": {
      "types": "./.dist/bundles.d.mts",
      "import": "./.dist/bundles.mjs"
    },
    "./messages/*": "./.dist/messages/*.mjs",
    "./config": "./prosary.config.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "prosary build",
    "stub": "prosary build",
    "prepare": "prosary build",
    "translate": "prosary translate",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@prosary/kit": "catalog:",
    "prosary": "catalog:"
  },
  "devDependencies": {
    "@prosary/kit": "catalog:",
    "@types/node": "catalog:",
    "prosary": "catalog:",
    "vitest": "catalog:"
  }
}
