{
  "name": "@zoobzio/editor",
  "version": "0.0.6",
  "description": "Headless rich text editor service over tiptap: one document, a feature set, the snapshot a view reads, reader/writer seams for the document form a consumer ingests and consumes, and the json, html, and hast codecs. No framework dependency.",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "packages/editor"
  },
  "files": [
    ".dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "catalog:",
    "@tiptap/html": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@types/hast": "catalog:",
    "@zoobzio/kit": "workspace:*",
    "hast-util-from-html": "catalog:",
    "hast-util-to-html": "catalog:"
  }
}
