{
  "name": "@zoobzio/time",
  "version": "0.1.12",
  "description": "The time the headless services share: JSCalendar 2.0 as types, the patch its entries change by, the recurrence they expand into over a range, and the zone arithmetic under both, on Temporal. No framework dependency.",
  "license": "MIT",
  "author": {
    "name": "Alex Thorwaldson",
    "email": "alex@zoobz.io",
    "url": "https://zoobz.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/foundation.git",
    "directory": "packages/time"
  },
  "files": [
    ".dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.mts",
      "import": "./.dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "rrule-temporal": "catalog:",
    "temporal-polyfill": "catalog:"
  }
}
